diff --git a/notes/exporters.py b/notes/exporters.py
index 2081041..2180f74 100644
--- a/notes/exporters.py
+++ b/notes/exporters.py
@@ -7,16 +7,18 @@ from .registry import register
 
 @register("json")
 class JsonExporter:
-    def export(self, notes: List[dict], dest: str) -> None:
+    def export(self, notes: List[dict], dest: str) -> int:
         with open(dest, "w", encoding="utf-8") as f:
             json.dump(notes, f, indent=2)
+        return len(notes)
 
 
 @register("csv")
 class CsvExporter:
-    def export(self, notes: List[dict], dest: str) -> None:
+    def export(self, notes: List[dict], dest: str) -> int:
         with open(dest, "w", encoding="utf-8", newline="") as f:
             writer = csv.DictWriter(f, fieldnames=["id", "title", "body"])
             writer.writeheader()
             for note in notes:
                 writer.writerow({k: note.get(k, "") for k in ("id", "title", "body")})
+        return len(notes)
diff --git a/notes/registry.py b/notes/registry.py
index 384739a..df78856 100644
--- a/notes/registry.py
+++ b/notes/registry.py
@@ -3,8 +3,14 @@ from typing import Callable, Dict, List, Protocol
 
 
 class Exporter(Protocol):
-    def export(self, notes: List[dict], dest: str) -> None:
-        """Write the notes to dest."""
+    def export(self, notes: List[dict], dest: str) -> int:
+        """Write the notes to dest and return how many were written."""
+
+
+class UnknownFormatError(LookupError):
+    def __init__(self, name: str) -> None:
+        super().__init__(f"unknown export format: {name}")
+        self.name = name
 
 
 EXPORTERS: Dict[str, Callable[[], Exporter]] = {}
@@ -18,4 +24,6 @@ def register(name: str) -> Callable[[type], type]:
 
 
 def get_exporter(name: str) -> Exporter:
+    if name not in EXPORTERS:
+        raise UnknownFormatError(name)
     return EXPORTERS[name]()
